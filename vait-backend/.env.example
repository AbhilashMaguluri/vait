# VAIT Environment Configuration
# Copy this file to .env and adjust if needed

# LLM Provider Configuration
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Primary LLM (Groq)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_CHAT_COMPLETIONS_URL=https://api.groq.com/openai/v1/chat/completions

# Fallback LLM (OpenRouter)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_CHAT_COMPLETIONS_URL=https://openrouter.ai/api/v1/chat/completions

# Embeddings
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536
OPENROUTER_EMBEDDINGS_URL=https://openrouter.ai/api/v1/embeddings

# Timeouts (seconds)
GROQ_TIMEOUT_SECONDS=12
OPENROUTER_TIMEOUT_SECONDS=18
EMBEDDINGS_TIMEOUT_SECONDS=20

# Application Settings
DEBUG=false
MONGODB_URI=mongodb://localhost:27017/vait
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000
JWT_SECRET=change-me-in-production
JWT_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/vait/auth/google/callback
FRONTEND_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# Official-site bootstrap for an empty FAISS index
AUTO_INGEST_OFFICIAL_SITES_ON_EMPTY=true
OFFICIAL_BOOTSTRAP_DEPTH_LIMIT=1
OFFICIAL_BOOTSTRAP_MAX_PAGES=24

# Optional: Override RAG settings
# CHUNK_SIZE=400
# CHUNK_OVERLAP=50
# TOP_K_RETRIEVAL=4
# SIMILARITY_THRESHOLD=0.75
